#usda 1.0
(
    defaultPrim = "Object"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Object" (
    prepend apiSchemas = ["PhysicsMassAPI", "PhysicsRigidBodyAPI"]
)
{
    float physics:mass = 0.1
    bool physics:rigidBodyEnabled = true
